{
  "name": "@anvil/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "mkdir -p dist && cp -r src/* dist/ && mkdir -p dist/public && (cp -r public/* dist/public/ 2>/dev/null || true)",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "nanoid": "^5.1.0",
    "nats": "^2.29.1",
    "pg": "^8.13.3"
  }
}
